{
  "name": "company-hq-host",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "童医魔盒 3D 总部的宿主场景与页面（线上前端协作副本，不含服务端与业务实现）。",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && vite build --config vite.pages.config.js",
    "preview": "vite preview",
    "preview:demo": "vite preview --config vite.pages.config.js --port 5399 --strictPort"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "sharp": "^0.35.5",
    "three": "0.186.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/three": "^0.183.1",
    "typescript": "^5.6.3",
    "vite": "^8.0.0"
  }
}
